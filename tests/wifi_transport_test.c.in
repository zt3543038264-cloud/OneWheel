int small_driver_trace_request(unsigned index) { trace_request_value=index;++trace_request_calls;return 1; }
int small_driver_trace_take(char *out,unsigned capacity) { if(!trace_mock_reply)return 0;unsigned n=(unsigned)strlen(trace_mock_reply);assert(n<capacity);memcpy(out,trace_mock_reply,n+1);trace_mock_reply=NULL;return (int)n; }
